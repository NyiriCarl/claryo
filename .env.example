# ─────────────────────────────────────────────────────────────────────────────
# Environment template. Copy to .env.local for local development.
# Never commit real secrets. See docs/SETUP.md for what each value does.
# ─────────────────────────────────────────────────────────────────────────────

# ── Web app (VITE_*) ── everything here is bundled into the browser, so only
#    PUBLIC values belong in this section.

# Product name while trademark/domain checks are pending (defaults to the
# values in src/brand.config.ts).
VITE_BRAND_NAME=
VITE_BRAND_SHORT_NAME=

# API base URL. Leave empty to use the Supabase project in utils/supabase/info.tsx.
# Local API: http://localhost:8787/make-server-b327929d
VITE_API_URL=

# Supabase project URL and public anon key (safe to expose; never put the
# service-role key here).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# supabase | dev | none
#   supabase: real accounts (email + password with confirmation, optional Google)
#   dev:      local test sign-in, only works against a server with DEV_AUTH=true
#   none:     guest-only build, no sign-in
VITE_AUTH_PROVIDER=supabase

# Show "Continue with Google" (enable the Google provider in Supabase first).
VITE_GOOGLE_SIGN_IN=false

# Run the demo planner in the browser without any API (static prototype only).
VITE_LOCAL_DEMO_AI=false

# ── Server (edge function / local API) ── set these as Supabase function
#    secrets (supabase secrets set NAME=value) or in your shell for server/dev.ts.
#    They are never sent to the browser.

# Without ANTHROPIC_API_KEY the server runs in clearly-labelled demo mode.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high
AI_EFFORT=medium
AI_TIMEOUT_MS=90000

# Daily generation limits (defaults shown).
LIMIT_GUEST_PLANS_PER_DAY=5
LIMIT_USER_PLANS_PER_DAY=20
LIMIT_GUEST_SIMPLIFY_PER_DAY=20
LIMIT_USER_SIMPLIFY_PER_DAY=100

# Comma-separated list of allowed web origins (default "*").
ALLOWED_ORIGINS=
# Random string used to hash guest IP addresses for rate limiting.
RATE_LIMIT_SALT=

# Provided automatically by Supabase in deployed functions.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Local API only (server/dev.ts).
PORT=8787
DEV_AUTH=false
DEV_DATA_FILE=.data/dev-kv.json
